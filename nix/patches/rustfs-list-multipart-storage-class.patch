+    #[test]
+    fn test_list_multipart_uploads_reports_effective_storage_class() {
+        for (stored, expected) in [
+            (None, "STANDARD"),
+            (Some("STANDARD_IA"), "STANDARD"),
+            (Some("REDUCED_REDUNDANCY"), "REDUCED_REDUNDANCY"),
+        ] {
+            let mut upload = MultipartInfo {
+                object: "object".to_string(),
+                upload_id: "upload".to_string(),
+                ..Default::default()
+            };
+            if let Some(stored) = stored {
+                upload.user_defined.insert("x-amz-storage-class".to_string(), stored.to_string());
+            }
+            let output = build_list_multipart_uploads_output(
+                "bucket".to_string(),
+                String::new(),
+                ListMultipartsInfo {
+                    uploads: vec![upload],
+                    ..Default::default()
+                },
+            );
+            let xml = String::from_utf8(crate::storage::storage_api::serialize(&output).unwrap()).unwrap();
+            assert!(
+                xml.contains(&format!("<StorageClass>{expected}</StorageClass>")),
+                "stored class {stored:?}: {xml}"
+            );
+        }
+    }
